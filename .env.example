PORT=4173
HOST=127.0.0.1
DATA_FILE=data/database.json

# AI runs in mock mode by default. Set AI_PROVIDER=openai and add a key when ready.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Google Workspace runs in mock mode by default. Real OAuth is wired as an adapter boundary.
GOOGLE_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4173/api/google/oauth/callback

# Optional future channel for reminders.
SMTP_MODE=mock
TELEGRAM_MODE=mock
